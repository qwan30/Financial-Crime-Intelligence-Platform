  "cards": [
    {
      "dot": "emerald",
      "title": "Hydration Contract",
      "items": [
        "GET /cases/{case_id}/workbench retrieves case snapshot, evidence items, and trace graph",
        "In-memory CaseService, EvidenceStore, and GraphRepo provide sub-millisecond local reads"
      ]
    },
    {
      "dot": "rose",
      "title": "Guarded Hypothesis Flow",
      "items": [
        "DeepSeek agent execution is budgeted, optional, and fails closed in LLM_OFF mode",
        "Every generated material claim must cite evidence IDs already attached to the case"
      ]
    },
    {
      "dot": "cyan",
      "title": "Analyst Feedback",
      "items": [
        "Analyst reviews graph, evidence items, and hypothesis claims in React workbench",
        "POST /cases/{case_id}/feedback records disposition and justification with idempotency"
      ]
    }
  ]
