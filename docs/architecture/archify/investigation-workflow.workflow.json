      "from": "citation_val",
      "to": "render_ui",
      "label": "verified",
      "variant": "emphasis"
    },
    {
      "id": "edge-ui-decision",
      "from": "render_ui",
      "to": "submit_feedback",
      "label": "review"
    },
    {
      "id": "edge-decision-api",
      "from": "submit_feedback",
      "to": "append_feedback",
      "label": "submit",
      "variant": "emphasis"
    }
