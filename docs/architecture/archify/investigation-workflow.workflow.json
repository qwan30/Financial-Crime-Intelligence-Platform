    {
      "id": "phase_investigation",
      "label": "Guarded Reasoning",
      "fromCol": 3,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "phase_adjudication",
      "label": "Analyst Feedback",
      "fromCol": 5,
      "toCol": 5,
      "variant": "default"
    }
  ],
  "mainPath": [
    "analyst_open",
    "route_workbench",
    "load_case_ev",
    "traverse_graph",
    "deepseek_gen",
    "citation_val",
    "render_ui",
    "submit_feedback",
    "append_feedback"
