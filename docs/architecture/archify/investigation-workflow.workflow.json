{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Investigation & Adjudication Workflow",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "investigation-workflow.html",
    "views": [
      {
        "id": "workbench-hydration",
        "label": "Workbench Hydration",
        "focus": ["analyst_open", "route_workbench", "load_case_ev", "traverse_graph", "render_ui"],
        "note": "Follow GET /workbench from analyst UI through in-memory state hydration."
      },
      {
        "id": "guarded-hypothesis",
        "label": "Guarded Hypothesis Flow",
        "focus": ["traverse_graph", "deepseek_gen", "citation_val", "render_ui"],
        "note": "Trace fail-closed DeepSeek prompt generation and citation validation."
      },
      {
        "id": "adjudication-feedback",
        "label": "Adjudication & Feedback",
        "focus": ["render_ui", "submit_feedback", "append_feedback"],
        "note": "Follow analyst disposition decision to idempotent feedback storage."
      }
    ]
  },
  "lanes": [
    {
      "id": "ui",
      "label": "Investigator Web (UI)"
    },
    {
      "id": "api_stores",
      "label": "Case API & In-Memory Repositories"
    },
    {
      "id": "agent",
      "label": "Guarded DeepSeek Pipeline",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "phase_hydration",
      "label": "Case Hydration",
      "fromCol": 0,
      "toCol": 2
